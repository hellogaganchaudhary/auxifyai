# Local development environment template. Copy to `.env` and adjust as needed.
# `.env` is git-ignored; never commit real secrets (Req 34.7, 35.1).

# --- PostgreSQL 16 + pgvector ---
POSTGRES_USER=auxify
POSTGRES_PASSWORD=auxify_dev_password
POSTGRES_DB=auxify
POSTGRES_PORT=5432
DATABASE_URL=postgresql://auxify:auxify_dev_password@localhost:5432/auxify
# Set true in production/staging so the API fails fast when Postgres is down.
REQUIRE_DATABASE=false

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible object store) ---
MINIO_ROOT_USER=auxify
MINIO_ROOT_PASSWORD=auxify_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=auxify-local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=auxify
S3_SECRET_ACCESS_KEY=auxify_dev_password
S3_BUCKET=auxify-local
S3_REGION=us-east-1

# --- API server (apps/api) ---
# Port/host the local API server binds (defaults: 8787 / 127.0.0.1).
API_PORT=8787
API_HOST=127.0.0.1
# Allowed browser CORS origins for the API (comma-separated exact origins).
# Never use `*` — combined with the known dev key it allows any website the
# operator visits to read API responses and burn provider quota.
API_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Local-dev credentials the bundled web app presents. These are DEV-ONLY; in
# production, auth is per-user via a real sign-in. Never use these live.
DEV_API_KEY=dev-local-key
DEV_API_TOKEN=dev-local-token

# --- Application login (single shared super-admin credential) ---
# Validated server-side by POST /v1/auth/login (password never reaches the
# browser). Set these to your own values; never commit real secrets here.
APP_AUTH_EMAIL=admin@example.com
APP_AUTH_PASSWORD=
APP_AUTH_SECRET=set-a-long-random-secret

# --- AI providers ---
# AWS Bedrock (Anthropic Claude). The Bedrock API key (bearer token). In this
# repo it is read from infra/aws/AWS.ENV (git-ignored) if present.
AWS_BEARER_TOKEN_BEDROCK=
# Region the Bedrock runtime is called in.
BEDROCK_REGION=ap-south-1
# Claude deployment ids; defaults match infra/aws/AWS_SETUP.md.
BEDROCK_MODEL_OPUS_46=global.anthropic.claude-opus-4-6-v1
BEDROCK_MODEL_OPUS=global.anthropic.claude-opus-4-5-20251101-v1:0
BEDROCK_MODEL_SONNET=global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_HAIKU=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Azure AI Foundry / Azure OpenAI (GPT / reasoning / image). All three required
# to enable Azure models in the picker.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# API version for GPT-5-family / o-series reasoning deployments.
AZURE_OPENAI_REASONING_API_VERSION=2024-12-01-preview

# Image generation (often a separate Azure resource/region, e.g. eastus2).
AZURE_OPENAI_EASTUS2_ENDPOINT=
AZURE_OPENAI_EASTUS2_API_KEY=
AZURE_OPENAI_DEPLOYMENT_IMAGE=
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview
# Sora 2 video generation (POST /openai/v1/videos?api-version=preview).
AZURE_OPENAI_DEPLOYMENT_VIDEO=
AZURE_OPENAI_VIDEO_API_VERSION=preview
# Realtime audio (voice conversation) deployment.
AZURE_OPENAI_DEPLOYMENT_REALTIME=
AZURE_OPENAI_REALTIME_API_VERSION=2025-04-01-preview

# Azure AI Foundry model-inference partner / MaaS models.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_INFERENCE_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
AZURE_FOUNDRY_DEPLOYMENT_GROK=
AZURE_FOUNDRY_DEPLOYMENT_GROK_REASONING=
AZURE_FOUNDRY_DEPLOYMENT_DEEPSEEK=
AZURE_FOUNDRY_DEPLOYMENT_DEEPSEEK_R1=
AZURE_FOUNDRY_DEPLOYMENT_KIMI=

# --- Web search providers (any one enables web search; rotation spreads load) ---
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
WEBSEARCHAPI_AI_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=

# --- Web app (apps/web) ---
# The API origin the web client calls, and the dev key it presents.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_API_KEY=dev-local-key
